# ResolveIQ Environment Configuration Template

# Server Settings
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Local standalone or replica set MongoDB:
DATABASE_URL="mongodb://localhost:27017/resolveiq_db"
# Or MongoDB Atlas Connection:
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/resolveiq_db?retryWrites=true&w=majority"

# JWT Authentication
JWT_SECRET="resolveiq_super_secret_jwt_key_2026_dev_mode"
JWT_EXPIRES_IN="7d"

# CORS and Client URL
CLIENT_URL="http://localhost:5173"

# SLA Scheduler Configuration
# Background SLA checking interval (in milliseconds)
SLA_CHECK_INTERVAL_MS=60000

# Optional AI Assistant API Key (Leave empty to use deterministic NLP rule-based engine)
# AI_PROVIDER_API_KEY="your-gemini-or-openai-api-key"

# Optional Email Provider Configuration (in-app notifications are active by default)
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT=2525
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="no-reply@resolveiq.com"
